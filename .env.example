# ==============================================================================
# ADA (Adaptive Dynamic Alarm) — Comprehensive Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or root for local deployment.
# NEVER commit real .env files or secret keys into version control.
# In production, inject secrets via platform secret managers (AWS Secrets Manager,
# GCP Secret Manager, Vault, Kubernetes Secrets, Doppler, or Render/Railway env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS (Public Configuration)
# ------------------------------------------------------------------------------
PROJECT_NAME="ADA - Adaptive Dynamic Alarm"
API_V1_STR="/api/v1"
ENVIRONMENT="development"            # Options: "development" | "testing" | "staging" | "production"
LOG_LEVEL="INFO"                     # Options: "DEBUG" | "INFO" | "WARNING" | "ERROR"
JSON_LOGGING="false"                 # Set to "true" for structured JSON log output (Datadog/CloudWatch)
ENABLE_DOCS="true"                   # Set to "false" in production to disable public /docs and /redoc
MAX_CONTENT_LENGTH_BYTES="2097152"   # 2 MB maximum HTTP payload limit (protects memory)
SECURE_HEADERS_ENABLED="true"        # Injects HSTS, CSP, X-Frame-Options, X-Content-Type-Options
ALLOWED_HOSTS='["*"]'                # Limit to production domains, e.g. '["api.ada-alarm.app"]'

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY SECRETS (Backend Private Secrets - NEVER EXPOSE)
# ------------------------------------------------------------------------------
# Required min 32 characters in production (e.g. generate with: openssl rand -hex 32)
SECRET_KEY="supersecret-ada-dev-key-change-in-production"

# AES-256 Fernet encryption key for encrypting OAuth tokens at rest in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + Connection Pooling)
# ------------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_USER="ada_admin"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_DB="ada_prod"
# If DATABASE_URL is set, it overrides the individual parameters above:
DATABASE_URL="postgresql://ada_admin:change_me_in_production@localhost:5432/ada_prod"

# Production Connection Pool Tuning
DB_POOL_SIZE=15                      # Steady-state connection pool size
DB_MAX_OVERFLOW=25                   # Maximum burst connections allowed
DB_POOL_TIMEOUT=30                   # Seconds to wait before timing out connection acquisition
DB_POOL_RECYCLE=1800                 # Recycle connections every 30 minutes (prevents cloud NAT drops)
DB_POOL_PRE_PING="true"              # Validate connection liveness before checking out from pool

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & CELERY TASK BROKER
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 5. FIREBASE AUTHENTICATION (Backend Admin SDK)
# ------------------------------------------------------------------------------
# Path to service account JSON key file (if running on non-GCP hosts)
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID="ada-dynamic-alarm"

# ------------------------------------------------------------------------------
# 6. EXTERNAL MAPS & ROUTING PROVIDERS (Google Maps + Mapbox Abstraction)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""               # Google Cloud Directions, Distance Matrix & Geocoding Key
MAPBOX_ACCESS_TOKEN=""               # Mapbox Directions & Geocoding Access Token

# Provider Fallback Policy
ROUTING_PROVIDER="google"            # Primary routing engine: "google" | "mapbox"
ROUTING_FALLBACK_PROVIDER="mapbox"   # Fallback routing engine: "mapbox" | "google"
GEOCODING_PROVIDER="google"          # Primary geocoding engine: "google" | "mapbox"
GEOCODING_FALLBACK_PROVIDER="mapbox" # Fallback geocoding engine: "mapbox" | "google"
ENABLE_PROVIDER_FALLBACK="true"
PROVIDER_TIMEOUT_SECONDS=6.0
GEOCODING_CACHE_TTL_SECONDS=86400    # 24 hours geocoding cache
ROUTE_CACHE_TTL_SECONDS=300          # 5 minutes route cache for traffic freshness
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 7. TRAFFIC RECALCULATION & SCHEDULE RECOVERY POLICY (Step 8)
# ------------------------------------------------------------------------------
TRAFFIC_REFRESH_INTERVAL_SECONDS=300 # Periodic traffic evaluation sweep (5 minutes)
UPCOMING_ALARM_WINDOW_SECONDS=14400  # 4 hours evaluation window before departure
ETA_CHANGE_THRESHOLD_SECONDS=180     # 3 minutes threshold to prevent schedule churn
ROUTE_FRESHNESS_SECONDS=600          # 10 minutes: route considered fresh
ROUTE_STALE_THRESHOLD_SECONDS=1800   # 30 minutes: route marked stale/outdated
MAX_PROVIDER_REQUESTS_PER_RUN=50     # Rate protection for batch runs
RECALCULATION_LOCK_TIMEOUT_SECONDS=30# Redis distributed lock TTL

# ------------------------------------------------------------------------------
# 8. NOTIFICATION DELIVERY & WEB PUSH (VAPID) (Step 9)
# ------------------------------------------------------------------------------
# Generate VAPID keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CLAIMS_EMAIL="mailto:admin@ada-alarm.app"
NOTIFICATION_RETENTION_DAYS=30
MAX_NOTIFICATION_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=60
NOTIFICATION_DELIVERY_BATCH_SIZE=100
NOTIFICATION_SWEEP_INTERVAL_SECONDS=30
NOTIFICATION_LOCK_TIMEOUT_SECONDS=20

# ------------------------------------------------------------------------------
# 9. WEATHER & CALENDAR CONTEXT INTELLIGENCE (Step 10)
# ------------------------------------------------------------------------------
WEATHER_PROVIDER="open-meteo"        # Options: "open-meteo" | "openweather" | "disabled"
WEATHER_API_KEY=""                   # Required only if using paid weather providers
WEATHER_CACHE_TTL_SECONDS=900        # 15 minutes
WEATHER_FORECAST_MAX_AGE_SECONDS=3600# 1 hour
WEATHER_BUFFER_DEFAULT_MINUTES=10
WEATHER_BUFFER_MAX_MINUTES=30
WEATHER_PRECIPITATION_THRESHOLD_MM=0.5
WEATHER_SWEEP_INTERVAL_SECONDS=600   # 10 minutes periodic context evaluation

# Google Calendar OAuth Integration
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:5173/settings?tab=calendar"
CALENDAR_SYNC_INTERVAL_SECONDS=900   # 15 minutes
CALENDAR_UPCOMING_WINDOW_DAYS=7

# ------------------------------------------------------------------------------
# 10. AI ASSISTANT & PERSONALIZATION (Step 11)
# ------------------------------------------------------------------------------
AI_PROVIDER="mock"                   # Options: "mock" (offline/tests) | "gemini" | "disabled"
AI_API_KEY=""                        # External LLM provider key (kept strictly on backend)
AI_MODEL_NAME="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_INPUT_LENGTH=1000
AI_CONVERSATION_HISTORY_ENABLED="true"
AI_CONVERSATION_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 11. CORS TRUSTED ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated or JSON list of authorized frontend origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
