# ==============================================================================
# ADA Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ for local development.
# In production, inject secrets via platform secret managers.
# ==============================================================================

PROJECT_NAME="ADA - Adaptive Dynamic Alarm"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
JSON_LOGGING="false"
ENABLE_DOCS="true"
MAX_CONTENT_LENGTH_BYTES="2097152"
SECURE_HEADERS_ENABLED="true"
ALLOWED_HOSTS='["*"]'

SECRET_KEY="supersecret-ada-dev-key-change-in-production"
TOKEN_ENCRYPTION_KEY=""

POSTGRES_SERVER="localhost"
POSTGRES_USER="ada_admin"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_DB="ada_prod"
DATABASE_URL="postgresql://ada_admin:change_me_in_production@localhost:5432/ada_prod"

DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING="true"

REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID="ada-dynamic-alarm"

GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

ROUTING_PROVIDER="google"
ROUTING_FALLBACK_PROVIDER="mapbox"
GEOCODING_PROVIDER="google"
GEOCODING_FALLBACK_PROVIDER="mapbox"
ENABLE_PROVIDER_FALLBACK="true"
PROVIDER_TIMEOUT_SECONDS=6.0
GEOCODING_CACHE_TTL_SECONDS=86400
ROUTE_CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=60

TRAFFIC_REFRESH_INTERVAL_SECONDS=300
UPCOMING_ALARM_WINDOW_SECONDS=14400
ETA_CHANGE_THRESHOLD_SECONDS=180
ROUTE_FRESHNESS_SECONDS=600
ROUTE_STALE_THRESHOLD_SECONDS=1800
MAX_PROVIDER_REQUESTS_PER_RUN=50
RECALCULATION_LOCK_TIMEOUT_SECONDS=30

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CLAIMS_EMAIL="mailto:admin@ada-alarm.app"
NOTIFICATION_RETENTION_DAYS=30
MAX_NOTIFICATION_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=60
NOTIFICATION_DELIVERY_BATCH_SIZE=100
NOTIFICATION_SWEEP_INTERVAL_SECONDS=30
NOTIFICATION_LOCK_TIMEOUT_SECONDS=20

WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_FORECAST_MAX_AGE_SECONDS=3600
WEATHER_BUFFER_DEFAULT_MINUTES=10
WEATHER_BUFFER_MAX_MINUTES=30
WEATHER_PRECIPITATION_THRESHOLD_MM=0.5
WEATHER_SWEEP_INTERVAL_SECONDS=600

GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:5173/settings?tab=calendar"
CALENDAR_SYNC_INTERVAL_SECONDS=900
CALENDAR_UPCOMING_WINDOW_DAYS=7

AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=10.0
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_INPUT_LENGTH=1000
AI_CONVERSATION_HISTORY_ENABLED="true"
AI_CONVERSATION_RETENTION_DAYS=30

CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
