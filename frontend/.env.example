# ==========================================
# ADA Frontend Environment Configuration
# ==========================================

VITE_APP_ENV="development"
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Firebase Authentication & Web SDK
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="ada-dynamic-alarm.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ada-dynamic-alarm"
VITE_FIREBASE_STORAGE_BUCKET="ada-dynamic-alarm.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ==========================================
# Dual Map Platform Provider Configuration
# Independent provider selection for map, routing, geocoding & traffic
# ==========================================

# Visual Map rendering engine ("mapbox" | "google")
VITE_MAP_PROVIDER="mapbox"

# Directions & Travel Calculation ("google" | "mapbox")
VITE_ROUTING_PROVIDER="google"

# Address Autocomplete & Coordinates ("google" | "mapbox")
VITE_GEOCODING_PROVIDER="google"

# Congestion & Live Incident stream ("google" | "mapbox")
VITE_TRAFFIC_PROVIDER="google"

# Automatic failover between Google and Mapbox
VITE_ENABLE_MAP_FALLBACK="true"

# Credentials (Client-safe public tokens)
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"
VITE_MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoieW91ci1hY2NvdW50IiwiYSI6InlvdXItdG9rZW4ifQ..."
